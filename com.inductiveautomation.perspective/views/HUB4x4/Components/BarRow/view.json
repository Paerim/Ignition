{
  "custom": {},
  "params": {
    "name": "Scratch",
    "value": 20,
    "max": 100,
    "text": "20%"
  },
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 26
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "alignItems": "center"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Name"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#1F2D3D",
            "fontSize": "12px",
            "textAlign": "right",
            "paddingRight": "8px",
            "whiteSpace": "nowrap"
          }
        },
        "position": {
          "basis": "110px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.name"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.progress",
        "version": 0,
        "meta": {
          "name": "Bar"
        },
        "props": {
          "value": 0,
          "min": 0,
          "max": 100,
          "bar": {
            "color": "#1F6FA8"
          },
          "track": {
            "color": "#E6EDF3"
          },
          "valueDisplay": {
            "enabled": false
          },
          "style": {
            "height": "16px"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.value"
              }
            }
          },
          "props.max": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.max"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Text"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#1F2D3D",
            "fontSize": "12px",
            "textAlign": "right",
            "paddingRight": "6px"
          }
        },
        "position": {
          "basis": "56px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.text"
              }
            }
          }
        }
      }
    ]
  },
  "propConfig": {
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.max": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}