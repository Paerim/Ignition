{
  "custom": {},
  "params": {
    "letter": "A"
  },
  "props": {
    "defaultSize": {
      "width": 30,
      "height": 36
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "borderRadius": "5px",
        "alignItems": "center",
        "margin": "2px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "L"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#FFFFFF",
            "fontSize": "20px",
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.letter"
              }
            }
          }
        }
      }
    ],
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "case({view.params.letter}, 'A', '#1F6FA8', 'B', '#23864A', 'C', '#E07B12', '#888888')"
          }
        }
      }
    }
  },
  "propConfig": {
    "params.letter": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}