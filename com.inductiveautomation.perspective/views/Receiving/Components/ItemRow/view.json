{
  "custom": {},
  "params": {
    "partNo": "T0001",
    "name": "CABIN",
    "qty": 20,
    "scanned": 0,
    "done": false
  },
  "props": {
    "defaultSize": {
      "width": 360,
      "height": 52
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "alignItems": "center",
        "gap": "8px",
        "padding": "6px 8px",
        "borderBottom": "1px solid #D9E1E8"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Name"
        },
        "props": {
          "direction": "column",
          "style": {
            "justifyContent": "center"
          }
        },
        "position": {
          "basis": "110px",
          "grow": 0,
          "shrink": 0
        },
        "children": [
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "Part"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "14px",
                "fontWeight": "bold",
                "color": "#1F2D3D"
              }
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.partNo"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "Desc"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "12px",
                "color": "#6B7A89"
              }
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.name"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.progress",
        "version": 0,
        "meta": {
          "name": "Bar"
        },
        "props": {
          "value": 0,
          "max": 1,
          "bar": {
            "color": "#2E86DE"
          },
          "track": {
            "color": "#E6EDF3"
          },
          "valueDisplay": {
            "enabled": false
          },
          "style": {
            "height": "10px",
            "borderRadius": "5px"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.scanned"
              }
            }
          },
          "props.max": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.qty"
              }
            }
          },
          "props.bar.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.done}, '#2DB84B', '#2E86DE')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Qty"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "15px",
            "fontWeight": "bold",
            "color": "#1F2D3D",
            "textAlign": "right"
          }
        },
        "position": {
          "basis": "70px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "concat({view.params.scanned}, '/', {view.params.qty})"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.icon",
        "version": 0,
        "meta": {
          "name": "Ok"
        },
        "props": {
          "path": "material/check_circle",
          "color": "#2DB84B",
          "style": {}
        },
        "position": {
          "basis": "24px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.done}, '#2DB84B', '#D0D7DE')"
              }
            }
          }
        }
      }
    ],
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.done}, '#EEF9F0', '#FFFFFF')"
          }
        }
      }
    }
  },
  "propConfig": {
    "params.partNo": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.qty": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.scanned": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.done": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}