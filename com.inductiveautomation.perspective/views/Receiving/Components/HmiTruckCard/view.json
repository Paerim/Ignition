{
  "custom": {},
  "params": {
    "truckNo": "Truck01",
    "arrivePlan": "08:15",
    "arriveActual": "",
    "departPlan": "08:20",
    "departActual": "",
    "status": ""
  },
  "props": {
    "defaultSize": {
      "width": 150,
      "height": 80
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#F7F9FB",
        "border": "1px solid #D9E1E8",
        "borderRadius": "6px",
        "padding": "4px 8px",
        "margin": "0 4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Truck"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "color": "#1F2D3D"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.truckNo"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "In"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "12px",
            "color": "#1F2D3D"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "concat('IN  ', {view.params.arrivePlan}, ' > ', if(len({view.params.arriveActual}) > 0, {view.params.arriveActual}, '--'))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Out"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "12px",
            "color": "#1F2D3D"
          }
        },
        "position": {
          "basis": "auto",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "concat('OUT ', {view.params.departPlan}, ' > ', if(len({view.params.departActual}) > 0, {view.params.departActual}, '--'))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Status"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "12px",
            "fontWeight": "bold",
            "color": "#FFFFFF",
            "textAlign": "center",
            "borderRadius": "4px"
          }
        },
        "position": {
          "basis": "18px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.status}) > 0, {view.params.status}, 'Waiting')"
              }
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "case({view.params.status}, 'On time', '#2DB84B', 'Delay', '#E53935', 'Advance', '#2E86DE', '#B0BAC4')"
              }
            }
          }
        }
      }
    ]
  },
  "propConfig": {
    "params.truckNo": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.arrivePlan": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.arriveActual": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.departPlan": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.departActual": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}